# 에듀트리 자격 증명. 이 파일을 .env 로 복사해 채우세요.
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 발급 방법은 docs/SETUP.md 참고.

# NEIS 교육정보 개방 포털
# 발급/조회: https://open.neis.go.kr/portal/myPage/actKeyPage.do
NEIS_API_KEY=

# 네이버 검색 API — 콘솔이 두 개입니다. 어느 쪽 키든 그대로 동작합니다.
#   신규: https://console.ncloud.com/naver-api-hub/application  (NAVER API Hub)
#   기존: https://developers.naver.com/apps                     (~2027-06-30)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# auto(기본) | hub | legacy — auto 는 첫 호출에서 통하는 쪽을 자동 선택
NAVER_API_MODE=auto

# 네이버 지도 — https://console.ncloud.com  Services → Maps → Application 등록
#   Web Dynamic Map + Geocoding 을 함께 선택하세요.
#   KEY_ID 는 브라우저에 노출되는 공개 키입니다(콘솔 도메인 허용목록으로 보호).
#   SECRET 은 지오코딩(서버 전용)에만 씁니다. 앱에 넣지 마세요.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Supabase — https://supabase.com/dashboard  (선택)
# service_role 키입니다. 서버/파이프라인에서만 쓰고 앱에는 anon 키를 쓰세요.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# anon 키는 앱에 들어갑니다. RLS 로 보호되며 공개돼도 되는 값입니다.
SUPABASE_ANON_KEY=

# 카페 심층 수집 (선택 · 로컬 전용). docs/SETUP.md 7단계를 먼저 읽으세요.
# EDUTREE_ENABLE_CAFE_SCRAPER=1
# EDUTREE_CAFE_HTML_DIR=~/edutree_cafe_pages
